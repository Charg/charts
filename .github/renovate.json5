{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Group all non-major digest/action bumps into as few PRs as reasonable.
    ":semanticCommits",
    ":semanticCommitScopeDisabled",
  ],

  // Match the repo's commit style (feat/fix/chore, no scope noise).
  semanticCommitType: "chore",

  // ghcr publishing is triggered by pushes to main that touch charts/**. Keep Renovate
  // branches out of that path except when it genuinely bumps a chart, and let CI gate merges.
  labels: ["dependencies"],
  rangeStrategy: "pin",
  configMigration: true,

  // Merge without review once CI is green, via GitHub's native auto-merge (main's ruleset
  // requires the ci checks). Nobody looks at these PRs first, so let each release age a week:
  // upstream yanks or re-tags a bad release in that window instead of it reaching ghcr.
  automerge: true,
  automergeType: "pr",
  platformAutomerge: true,
  minimumReleaseAge: "7 days",

  // Flake inputs (nixpkgs) tracked via the lockfile. Renovate re-locks against the pinned
  // nixos-26.05 branch ref rather than moving the ref itself.
  nix: {
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 6am on monday"],
    // Re-locking nixpkgs swaps the whole release toolchain; see the nix package rule below.
    automerge: false,
  },

  packageRules: [
    {
      // Majors can change values or storage layout; those still wait for a human.
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      // GitHub Actions are SHA-pinned with a version comment; keep that pinning on update. They
      // run inside the job that signs releases, so a compromised action release is a signed
      // malicious chart: a human reads these before they merge, however small.
      matchManagers: ["github-actions"],
      pinDigests: true,
      groupName: "github actions",
      automerge: false,
    },
    {
      // nixpkgs supplies helm, cosign and every other tool in the release job, for the same
      // reason as the actions above.
      matchManagers: ["nix"],
      automerge: false,
    },
    {
      // The same tag pointing at a new digest. Upstream re-pushing a tag is either a rebuild or a
      // compromise, and only a human can tell which.
      matchUpdateTypes: ["digest"],
      automerge: false,
    },
    {
      // Except for images this project builds and signs itself (Charg/containers), which are
      // rebuilt in place for base-image fixes. CI verifies their signature before merge.
      matchUpdateTypes: ["digest"],
      matchDepNames: ["charg/containers/**"],
      automerge: true,
    },
    {
      // The Technitium image is the payload. Surface it on its own so a DNS-server bump
      // is never buried in a group.
      matchDepNames: ["technitium/dns-server"],
      groupName: "technitium dns-server",
      commitMessageTopic: "Technitium DNS server",
    },
    {
      // Same for Vaultwarden. Its Docker Hub repo also publishes "-alpine" variants of every
      // release; Docker versioning treats the suffix as a compatibility marker, so a plain
      // "1.37.4" appVersion only ever moves to the next plain tag.
      matchDepNames: ["vaultwarden/server"],
      groupName: "vaultwarden server",
      commitMessageTopic: "Vaultwarden server",
    },
    {
      // Same for AnythingLLM. Its Docker Hub repo also publishes "pg-", "railway-" and "render-"
      // variants of every release plus floating "1.18"-style tags; only follow full plain releases.
      matchDepNames: ["mintplexlabs/anythingllm"],
      allowedVersions: "/^\\d+\\.\\d+\\.\\d+$/",
      groupName: "anythingllm",
      commitMessageTopic: "AnythingLLM",
    },
    {
      // Anki sync server, built by Charg/containers and tagged with the upstream Anki version
      // (YY.MM or YY.MM.patch). Only follow those plain release tags.
      matchDepNames: ["charg/containers/anki-sync-server"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$",
      groupName: "anki-sync-server",
      commitMessageTopic: "Anki sync server",
    },
    {
      // Hermes Agent. Its Docker Hub repo also publishes "-desktop" builds and "rc.N" release
      // candidates next to each release; only follow plain vX.Y.Z releases.
      matchDepNames: ["nousresearch/hermes-agent"],
      allowedVersions: "/^v\\d+\\.\\d+\\.\\d+$/",
      groupName: "hermes-agent",
      commitMessageTopic: "Hermes Agent",
    },
  ],

  // appVersion in each Chart.yaml is the source of truth for its image tag (values.yaml
  // image.tag defaults to .Chart.AppVersion), and the charg.github.io/image-digest annotation
  // beside it pins that tag's digest. Track the upstream tag and rewrite both together, so a
  // version bump can never leave the old digest behind (the runtime pulls by digest, so a stale
  // one would silently keep deploying the previous release). One manager per chart: the file pattern is what ties an appVersion to its image, so
  // a manager matching every Chart.yaml would track every chart against the same image.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/anki-sync-server/Chart\\.yaml$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "charg\\.github\\.io/image-digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "charg/containers/anki-sync-server",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://ghcr.io",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/technitium-dns-server/Chart\\.yaml$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "charg\\.github\\.io/image-digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "technitium/dns-server",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://index.docker.io",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/vaultwarden/Chart\\.yaml$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "charg\\.github\\.io/image-digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "vaultwarden/server",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://index.docker.io",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/anythingllm/Chart\\.yaml$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "charg\\.github\\.io/image-digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "mintplexlabs/anythingllm",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://index.docker.io",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/hermes-agent/Chart\\.yaml$/"],
      matchStringsStrategy: "combination",
      matchStrings: [
        "appVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "charg\\.github\\.io/image-digest:\\s*\"?(?<currentDigest>sha256:[a-f0-9]{64})\"?",
      ],
      depNameTemplate: "nousresearch/hermes-agent",
      datasourceTemplate: "docker",
      registryUrlTemplate: "https://index.docker.io",
    },
  ],

  // When a PR rewrites a chart's appVersion (or an image tag in its values.yaml), bump that
  // chart's own version so the release job publishes a new artifact. {{packageFileDir}} scopes
  // the bump to the Chart.yaml next to the file Renovate changed, so one chart's update never
  // bumps another chart. Actions/flake bumps have no Chart.yaml beside them, so they bump nothing.
  bumpVersions: [
    {
      filePatterns: ["{{packageFileDir}}/Chart.yaml"],
      matchStrings: ["\\sversion:\\s*(?<version>\\S+)"],
      bumpType: "patch",
    },
  ],
}
