# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# Chart-local unit test suite (root-level only; templates/tests/ holds the helm test hook
# and must stay in the packaged artifact).
/tests/
# Accepted trivy findings for lint/scan-images; repo tooling, not part of the chart.
/.trivyignore.yaml
